+/** Resolve short follow-ups from the user's own recent words. New topics stand alone. */
+export function historyRetrievalQuery(message: string, history: Array<{ role: string; content: string }>, observation: string) {
+  if (message.split(/\s+/).length > 20 || !/\b(that|this|it|more|continue|go on)\b/i.test(message)
+    || /\b(?:dog|mom|mother|father|brother|sister|work|dinner|cook|food|privacy|childhood|nightmare|attack|trauma|correction)\b/i.test(message)) return message;
+  const prior = [...history].reverse().find(turn => turn.role === 'user' && turn.content.trim() !== message.trim())?.content || observation;
+  return prior ? `${prior.slice(0, 800)}\nFOLLOW-UP: ${message}` : message;
+}
