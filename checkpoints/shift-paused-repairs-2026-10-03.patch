+import type { ShiftBreakdown } from '../../types/index.js';
+
+/** Use the actual reflection answer and its provenance, not a detached follow-up. */
+export function openingConversation(shift: ShiftBreakdown | null) {
+  if (!shift) return [];
+  const currentReport = shift.rawInput || shift.userEditedObservation || shift.observation;
+  const answer = shift.userEditedPerspective || shift.updated_perspective;
+  return [
+    { role: 'user' as const, content: currentReport },
+    { role: 'assistant' as const, content: [answer, shift.follow_up_question].filter(Boolean).join('\n\n'),
+      influence: shift.influence,
+      personalHistoryReferences: shift.userEditedPerspective ? undefined : shift.personalHistoryReferences,
+      personalHistoryUnavailable: shift.personalHistoryUnavailable,
+      educationalEvidence: shift.educationalEvidence,
+    },
+  ];
+}
